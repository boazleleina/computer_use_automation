# Committed. Copy to .env and fill in real values. .env is gitignored.
# Only infrastructure reads these — never domain code.
#
#   cp .env.example .env

# Model provider credential. Discovery needs it; replay does not.
ANTHROPIC_API_KEY=

# Target application under automation.

TARGET_APP_BASE_URL=http://127.0.0.1:5000

# Operator sign-on for the legacy fixture app. 
TARGET_APP_USER=tmiller
TARGET_APP_PASSWORD=changeme-local-only

# Session lifetime in seconds. Lower it to watch a run meet a real expiry.
TARGET_APP_SESSION_TTL=900

# Path to the config file the CLI loads.
CUA_CONFIG=config.yaml
